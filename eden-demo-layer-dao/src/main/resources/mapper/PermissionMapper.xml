<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
	"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.ylzl.eden.demo.dao.database.mapper.PermissionMapper">

	<resultMap id="dbResultMap"
			   type="org.ylzl.eden.demo.dao.database.dataobject.PermissionDO">
		<result column="id" property="id"/>
		<result column="code" property="code"/>
		<result column="name" property="name"/>
		<result column="type" property="type"/>
		<result column="parent_id" property="parentId"/>
		<result column="description" property="description"/>
		<result column="sort" property="sort"/>
		<result column="created_date" property="createdDate"/>
		<result column="last_modified_date" property="lastModifiedDate"/>
	</resultMap>

	<sql id="baseColumns">
		id, code, name, type, parent_id, description, sort, created_date, last_modified_date
	</sql>

	<select id="selectByCode" resultMap="dbResultMap">
		SELECT <include refid="baseColumns"/>
		FROM demo_permission
		WHERE code = #{code}
	</select>

	<select id="selectPage" resultMap="dbResultMap">
		SELECT <include refid="baseColumns"/>
		FROM demo_permission
		<where>
			<if test="code != null and code != ''">
				AND code LIKE CONCAT('%', #{code}, '%')
			</if>
			<if test="name != null and name != ''">
				AND name LIKE CONCAT('%', #{name}, '%')
			</if>
			<if test="type != null">
				AND type = #{type}
			</if>
		</where>
		ORDER BY sort ASC
	</select>

	<select id="selectAll" resultMap="dbResultMap">
		SELECT <include refid="baseColumns"/>
		FROM demo_permission
		ORDER BY sort ASC
	</select>

	<select id="selectByIds" resultMap="dbResultMap">
		SELECT <include refid="baseColumns"/>
		FROM demo_permission
		WHERE id IN
		<foreach collection="ids" item="id" open="(" separator="," close=")">
			#{id}
		</foreach>
	</select>

</mapper>
